+    st = {"task_id": "task-002", "mode": "tdd", "base_branch": "main", "verification": {"commands": []}}
+    (task_dir / "state.json").write_text(json.dumps(st), encoding="utf-8")
+
+    result = impl.run(task_dir, st)
