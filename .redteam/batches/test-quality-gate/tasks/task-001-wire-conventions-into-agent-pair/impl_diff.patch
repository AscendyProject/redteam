+    assert "docs/my-test-conventions.md" in p_ap
+
+    # REGRESSION: TDD must NOT include conventions
+    p_tdd = _impl()._tdd_base_prompt(_TD, _ProjWithConventions())
+    assert "docs/my-test-conventions.md" not in p_tdd
