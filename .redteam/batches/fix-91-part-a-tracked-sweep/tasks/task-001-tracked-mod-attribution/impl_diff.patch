+    result = impl._run_agent_pair(task_dir, st)
+
+    # Floor passes (in-scope); pre-edit captured in baseline → no tracked delta → NOT
+    # committed. The leftover in-scope edit then trips Layer 1 (baseline-INDEPENDENT).
